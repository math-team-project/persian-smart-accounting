API_KEY_B_AI=chjscj...
API_KEY_OPENROUTER=cdsjkf...
DEBUG=True

# --- Dashboard layer (users, projects, run history) ---------------------------
# Secret key used to sign the session cookie. REQUIRED in any real deployment:
# without it a fixed development default is used, which would let anyone forge a
# session cookie. Generate one with: python -c "import secrets;print(secrets.token_urlsafe(48))"
PSA_SECRET_KEY=change-me-to-a-long-random-string
# SQLite database of the dashboard (users/projects/history). Default: data/psa.db
# PSA_DB_URL=sqlite:///data/psa.db
# Where the *result* files of each run are kept (never the uploaded inputs).
# Default: data/results
# PSA_RESULTS_DIR=data/results
# Session cookie lifetime in seconds (default: 14 days)
# PSA_SESSION_MAX_AGE=1209600
# Encryption key for the per-project/per-workshop LLM API keys stored in the
# dashboard database. Must be a valid Fernet key; generate one with:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# API keys are never stored in plain text. When unset, a stable key is derived
# from PSA_SECRET_KEY (fine for local development) -- but in that case changing
# PSA_SECRET_KEY makes already-stored keys unreadable, so users must re-enter them.
# PSA_AI_SETTINGS_ENCRYPTION_KEY=
