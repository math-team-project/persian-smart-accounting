# =============================================================
# API keys for the providers used in config/providers.yaml.
# Copy this file to `.env` and fill in the values you actually use.
#
#   cp .env.example .env
#
# All keys are optional; a voter only needs the key(s) of the
# provider(s) it references in config/pipeline.yaml.
# =============================================================

# --- OpenAI direct ----------------------------------------------
OPENAI_API_KEY=

# --- DeepSeek (cheap, strong Persian) ---------------------------
DEEPSEEK_API_KEY=

# --- OpenRouter (many models behind one key) --------------------
OPENROUTER_API_KEY=
# --- Groq (fast inference, free tier available) -----------------
GROQ_API_KEY=

# --- Together AI ------------------------------------------------
TOGETHER_API_KEY=

# --- Mistral AI -------------------------------------------------
MISTRAL_API_KEY=

# --- Local Ollama / vLLM ----------------------------------------
# Local servers usually ignore the key; the SDK just needs a
# non-empty string to accept the request.
LOCAL_OPENAI_API_KEY=sk-local-dummy

# --- Local model cache (optional; overrides config/pipeline.yaml) ---
# HF_HOME=./.cache/models